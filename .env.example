# Your Mailtea API key: https://studio.mailtea.app/api-keys
MAILTEA_API_KEY=mt_pat_your_api_key_here

# The sender. Must be on a domain you have verified in Mailtea.
MAILTEA_FROM=Acme <hello@acme.com>

# Who receives the example emails.
MAILTEA_TO=reader@yourdomain.com

# Only needed for local dev or a self-hosted Mailtea. Leave it unset in
# production and the example uses https://api.mailtea.app.
# MAILTEA_API_BASE_URL=http://localhost:7787
